{
  "name": "map-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "assets:fetch": "tsx tools/mapgen/fetch.ts",
    "mapgen": "tsx tools/mapgen/build.ts",
    "test": "tsx --test tools/mapgen/*.test.ts src/game/*.test.ts",
    "cards:review": "node tools/card-review/server.mjs",
    "cards:assets": "node tools/card-review/sync-assets.mjs",
    "cards:check": "node --test tools/card-review/*.test.mjs",
    "test:solo": "tsx --test src/game/solo.test.ts",
    "solo:simulate": "tsx tools/solo-sim.ts",
    "test:solo:browser": "node tools/solo-browser.mjs",
    "test:cards:browser": "node tools/card-ux-browser.mjs",
    "test:hand:browser": "node tools/hand-browser.mjs",
    "test:scoring:browser": "node tools/scoring-browser.mjs",
    "test:reveals:browser": "node tools/reveal-history-browser.mjs",
    "test:transfers:browser": "node tools/card-transfer-browser.mjs",
    "test:card-motion:browser": "node tools/card-motion-browser.mjs",
    "test:unseen:browser": "node tools/unseen-browser.mjs",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "dev:online": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run infra:bootstrap && npm run build && npm run typecheck:worker && wrangler deploy",
    "deploy:check": "npm run build && npm run typecheck:worker && wrangler deploy --dry-run",
    "test:online": "tsx --test src/net/*.test.ts",
    "test:online:browser": "node tools/online-browser.mjs",
    "cf:login": "wrangler login --scopes user:read account:read workers:write workers_scripts:write",
    "infra:bootstrap": "node tools/cloudflare-bootstrap.mjs",
    "test:online:live": "tsx tools/online-smoke.ts",
    "test:audio": "tsx --test src/audio/*.test.ts",
    "test:chat:server": "tsx tools/chat-smoke.ts",
    "test:chat:browser": "node tools/chat-browser.mjs",
    "test:tutorial": "tsx --test src/game/tutorial.test.ts",
    "test:tutorial:browser": "node tools/tutorial-browser.mjs",
    "test:i18n": "tsx --test src/i18n/*.test.ts",
    "test:i18n:browser": "node tools/i18n-browser.mjs",
    "test:i18n:online": "node tools/i18n-online-browser.mjs",
    "test:i18n:tutorial": "node tools/i18n-online-browser.mjs --tutorial"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^22.20.5",
    "@types/three": "^0.180.0",
    "extract-zip": "^2.0.1",
    "geotiff": "^3.0.5",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "wrangler": "^4.162.0"
  }
}
