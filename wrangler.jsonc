{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coldwar-duel",
  "account_id": "0df82ca444cc58459dbd9223b9310931",
  "vars": { "PAGES_ORIGIN": "https://realcwl.github.io" },
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/api/*", "/cards/help/*.mp4", "/audio/music/*.m4a"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRoom"] }],
  "ratelimits": [
    {
      "name": "ROOM_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
